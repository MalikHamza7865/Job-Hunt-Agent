# Copy this file to .env and fill in real values. NEVER commit .env.

# Supabase (https://supabase.com/dashboard -> Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the service_role key for scripts (bypasses Row Level Security)
SUPABASE_KEY=YOUR-SERVICE-ROLE-KEY

# Groq free tier (https://console.groq.com -> API Keys).
# Free-tier chat models: openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.6-27b,
# qwen/qwen3.8-27b. (llama-3.x models moved to Enterprise; they 404 on free tier.)
GROQ_API_KEY=YOUR-GROQ-API-KEY
GROQ_MODEL=qwen/qwen3.8-27b

# ---- Job source (default: adzuna) ---------------------------------------
# Adzuna = free official API, no partner approval, no scraping.
# Sign up at https://developer.adzuna.com -> Applications -> Create.
FETCH_SOURCE=adzuna            # adzuna (default) | indeed | sample
ADZUNA_APP_ID=YOUR-ADZUNA-APP-ID
ADZUNA_APP_KEY=YOUR-ADZUNA-APP-KEY
ADZUNA_COUNTRY=us              # supported feeds: at au be ca de es eu fr gb ie in it mx nl nz pl ro sg us
# ADZUNA_VERBOSE=1             # print the exact request URL + response status for each query

# Indeed (official OAuth + GraphQL API; PARTNER-GATED, needs an approved app).
# Only usable if you obtain Indeed partner access (see README "Why Adzuna?").
# Auth: one-time interactive login via
#   python app/auth_indeed.py
# That saves a token file to INDEED_TOKEN_FILE. In GitHub Actions, store the
# file's contents as a secret and restore it in the workflow.
INDEED_TOKEN_FILE=.indeed_tokens.json
# Advanced: override the client / endpoints. The default client_id is a
# pre-whitelisted client-ID metadata document (https://claude.ai/oauth/
# claude-code-client-metadata); override if you obtain your own registration.
# INDEED_CLIENT_ID=https://claude.ai/oauth/claude-code-client-metadata
# INDEED_REDIRECT_URL=http://127.0.0.1:19876/callback
# INDEED_GRAPHQL_URL=https://apis.indeed.com/graphql

# WhatsApp Cloud API (Meta Developers)
WHATSAPP_TOKEN=YOUR-WHATSAPP-ACCESS-TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR-PHONE-NUMBER-ID
# The phone number that receives notifications (E.164 format, e.g. 15551234567)
RECIPIENT_PHONE=15551234567
WHATSAPP_VERIFY_TOKEN=SET-ANY-RANDOM-STRING
# App secret (Meta App Dashboard -> App settings -> Basic) - used to verify
# inbound webhook requests (X-Hub-Signature-256). Recommended for the webhook.
WHATSAPP_APP_SECRET=YOUR-APP-SECRET
# 24-hour-window fallback: free-form messages only work while the recipient has
# messaged within the last 24h. Outside it, an APPROVED template is required.
# Approve the "job_match_alert" template in Meta (WhatsApp -> Message templates)
# then set the name here to enable the notify.py fallback.
# WHATSAPP_TEMPLATE_NAME=job_match_alert
# WHATSAPP_TEMPLATE_LANG=en